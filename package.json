{
  "name": "ai-signal",
  "version": "0.1.0",
  "description": "Daily aggregator of AI news, research, tutorials, tools and releases.",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "collect": "NODE_USE_ENV_PROXY=1 node scripts/collect.js",
    "dedupe": "node scripts/dedupe.js",
    "rank": "node scripts/rank.js",
    "build": "node scripts/build.js",
    "check": "node scripts/validate.js && node scripts/sync-subscribe.js --check && node scripts/build.js --check && NODE_USE_ENV_PROXY=1 node scripts/gate.js",
    "sync": "node scripts/sync-subscribe.js",
    "test": "node --test",
    "serve": "node scripts/serve.js",
    "verify-sources": "NODE_USE_ENV_PROXY=1 node scripts/verify-sources.js",
    "daily": "node scripts/daily.js",
    "daily:start": "node scripts/daily.js start",
    "daily:publish": "node scripts/daily.js publish",
    "daily:summary": "node scripts/daily.js summary",
    "daily:fail": "node scripts/daily.js fail"
  },
  "dependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "fast-xml-parser": "^5.11.2"
  }
}
