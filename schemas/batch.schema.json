{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-signal.example/schemas/batch.schema.json",
  "title": "Batch",
  "description": "data/work/YYYY-MM-DD.batch-N.json: ~30 candidates with only what Claude needs to judge them.",
  "type": "object",
  "additionalProperties": false,
  "required": ["date", "batch", "of", "clusters", "items"],
  "properties": {
    "date": { "$ref": "common.schema.json#/$defs/editionDate" },
    "batch": { "type": "integer", "minimum": 1 },
    "of": { "type": "integer", "minimum": 1 },
    "clusters": {
      "description": "Clusters whose stories are in this batch (all of a cluster's stories are in one batch).",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label", "size", "sources", "trendDelta"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
          "label": { "description": "Placeholder (the lead story's title); Claude writes the real label.", "type": "string" },
          "size": { "type": "integer", "minimum": 2 },
          "sources": { "type": "array", "items": { "type": "string" } },
          "trendDelta": { "type": ["number", "null"] }
        }
      }
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "source", "sourceTier", "url", "author", "publishedAt", "categoryHint", "signals", "trendDelta", "trendBaseline", "previouslyFeatured", "clusterId", "clusterLabel"],
        "properties": {
          "id": { "$ref": "common.schema.json#/$defs/sha1" },
          "title": { "type": "string" },
          "source": { "type": "string" },
          "sourceTier": { "type": "integer", "minimum": 1, "maximum": 3 },
          "url": { "$ref": "common.schema.json#/$defs/httpUrl" },
          "author": { "type": ["string", "null"] },
          "publishedAt": { "$ref": "common.schema.json#/$defs/utcTimestamp" },
          "categoryHint": { "type": ["string", "null"] },
          "signals": { "$ref": "raw-item.schema.json#/$defs/base/properties/signals" },
          "trendDelta": { "type": ["number", "null"] },
          "trendBaseline": { "description": "Trend score computed from the numbers by the rubric's table; Claude may adjust it by at most 2.", "type": "integer", "minimum": 0, "maximum": 10 },
          "previouslyFeatured": { "type": "boolean" },
          "clusterId": { "type": ["string", "null"] },
          "clusterLabel": { "type": ["string", "null"] }
        }
      }
    }
  }
}
