{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-signal.example/schemas/keywords.schema.json",
  "title": "Keywords",
  "description": "sources/keywords.json: on-topic filters for community sources.",
  "type": "object",
  "additionalProperties": false,
  "required": ["include", "exclude"],
  "properties": {
    "include": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "exclude": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
  }
}
